# Local PostgreSQL in Docker (used by compose.yaml)
# Copy this file to .env and fill in the values
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# Connection string for the app (Drizzle)
# Format: postgresql://USER:PASSWORD@localhost:PORT/DB
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
SMTP_URL=
MAIL_FROM=
OWNER_EMAIL=