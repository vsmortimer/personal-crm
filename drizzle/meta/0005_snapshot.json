          "value": "(\"contacts\".\"birth_day\" is null) = (\"contacts\".\"birth_month\" is null)"
        },
        "contacts_birth_year_check": {
          "name": "contacts_birth_year_check",
          "value": "\"contacts\".\"birth_year\" is null or (\"contacts\".\"birth_day\" is not null and \"contacts\".\"birth_year\" between 1900 and 2200)"
        },
        "contacts_birth_date_check": {
          "name": "contacts_birth_date_check",
          "value": "\"contacts\".\"birth_day\" is null or (\"contacts\".\"birth_month\" between 1 and 12 and \"contacts\".\"birth_day\" between 1 and (case when \"contacts\".\"birth_month\" = 2 then 29 when \"contacts\".\"birth_month\" in (4, 6, 9, 11) then 30 else 31 end))"
        }
